package kz.arctan.grepractice.data.cloud

// Template for the git-ignored FirebaseSecrets.kt. Copy this file to FirebaseSecrets.kt (same
// folder) and fill in your values:
// - PROJECT_ID, API_KEY, ANDROID_APP_ID, STORAGE_BUCKET: from androidApp/google-services.json
//   (project_info.project_id, client[0].api_key[0].current_key, client[0].client_info.mobilesdk_app_id,
//   project_info.storage_bucket).
// - WEB_CLIENT_ID: the oauth_client entry with client_type 3 in google-services.json.
// - DESKTOP_OAUTH_CLIENT_ID / _SECRET: a "Desktop app" OAuth client from Google Cloud console →
//   APIs & Services → Credentials. Leave both empty to hide Google sign-in on desktop.
internal object FirebaseSecrets {
    const val PROJECT_ID = ""
    const val API_KEY = ""
    const val ANDROID_APP_ID = ""
    const val STORAGE_BUCKET = ""
    const val WEB_CLIENT_ID = ""
    const val DESKTOP_OAUTH_CLIENT_ID = ""
    const val DESKTOP_OAUTH_CLIENT_SECRET = ""
}
